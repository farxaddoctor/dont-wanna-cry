# Server Configuration
PORT=5000
NODE_ENV=development

# Active Directory Configuration
AD_URL=ldap://your-domain-controller.local:389
AD_BASE_DN=DC=company,DC=local
AD_USERNAME=admin@company.local
AD_PASSWORD=your-password

# SIEM Configuration (Splunk/ELK/QRadar)
SIEM_TYPE=splunk
SIEM_URL=https://your-siem-server:8089
SIEM_API_KEY=your-siem-api-key
SIEM_INDEX=ransomware_sim

# Security
JWT_SECRET=your-jwt-secret-key-change-this
ADMIN_PASSWORD=admin123

# Simulation Settings
SIMULATION_TIMEOUT=300000
MAX_CONCURRENT_SIMULATIONS=5

# GitHub Configuration for Ransomware Samples
GITHUB_TOKEN=your-github-token-optional

# AI Report Generation (Optional - uses intelligent templates if not configured)
OPENAI_API_KEY=your-openai-api-key-optional
AI_MODEL=gpt-4
